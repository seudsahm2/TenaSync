datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  CLINICIAN
  ADMIN
}

enum ConsultationStatus {
  ACTIVE
  COMPLETED
  MANUAL_TAKEOVER
  CANCELLED
}

model User {
  id                   String              @id @default(uuid())
  telegramId           BigInt              @unique
  username             String?
  firstName            String
  role                 Role                @default(PATIENT)
  
  // Telegram Business API Connection Credentials
  businessConnectionId String?             @unique
  canReply             Boolean             @default(false)
  isVerifiedClinician  Boolean             @default(false)
  
  // Clinician Specialty & Treatment Options
  specialty            String?                           // e.g., "Spine & Posture", "Postpartum Care", "Nutrition"
  treatmentOptions     String[]            @default([])  // e.g., ["In-Home", "Hospital", "Telehealth"]
  rating               Float               @default(5.0)
  reviewCount          Int                 @default(0)
  
  // Somatic Biometric State Metrics
  postureStrainIndex   Float               @default(0.0) // Calculated via sedentary stress factors
  postpartumDay        Int?                              // If active, tracks maternal cycle day
  hypertensionFlag     Boolean             @default(false)
  
  // Consultation Relations
  patientConsultations ConsultationSession[] @relation("PatientRelation")
  clinicianConsultations ConsultationSession[] @relation("ClinicianRelation")
  documents            ClinicianDocument[] // Clinician knowledge books/guidelines
  availabilities       DoctorAvailability[] @relation("ClinicianAvailability")
  
  // Patient Profile & Recovery Relations
  patientProfile       PatientProfile?
  recoveryLogs         RecoveryLog[]
  medicationReminders  MedicationReminder[]
  
  // Specialized Domain
  specializedProfile   SpecializedProfile?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model PatientProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Demographics
  fullName           String?
  age                Int?
  gender             String?
  phoneNumber        String?
  preferredLanguage  String   @default("English")
  location           String?
  emergencyContact   String?
  
  // Lifestyle Info
  occupation         String?
  activityLevel      String?
  workStyle          String?
  
  // Medical Info
  existingConditions String?
  allergies          String?
  currentMedications String?
  previousInjuries   String?
  
  // Privacy Options
  anonymousMode      Boolean  @default(false)
  womensPrivacyMode  Boolean  @default(false)
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RecoveryLog {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  painLevel          Int      // 0 to 10
  energyLevel        String   // "Low", "Medium", "High"
  mobility           String   // "Improving", "No Change", "Worsening"
  exerciseCompleted  Boolean  @default(false)
  notes              String?
  
  createdAt          DateTime @default(now())
}

model MedicationReminder {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medName     String
  dosage      String
  time        String
  isTaken     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
}

model ClinicianDocument {
  id        String   @id @default(uuid())
  title     String
  content   String   // The text extracted from the document
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model DoctorAvailability {
  id          String   @id @default(uuid())
  clinicianId String
  user        User     @relation("ClinicianAvailability", fields: [clinicianId], references: [id], onDelete: Cascade)
  dayOfWeek   Int      // 0 = Sunday, 1 = Monday, etc.
  startTime   String   // "09:00"
  endTime     String   // "17:00"
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConsultationSession {
  id                    String              @id @default(uuid())
  sessionId             String              @unique
  patientSymptoms       String              // Initial symptoms described by patient
  consultationType      String?             // "In-Home", "Hospital", "Telehealth"
  scheduledTime         DateTime?           // Booked appointment time
  
  status                ConsultationStatus  @default(ACTIVE)
  autoReplyEnabled      Boolean             @default(true)      // Auto-reply/consultation mode flag
  aiSummary             String?             // AI Generated Patient Summary
  
  // Relational Foreign Keys
  patientId             String
  patient               User                @relation("PatientRelation", fields: [patientId], references: [id])
  clinicianId           String
  clinician             User                @relation("ClinicianRelation", fields: [clinicianId], references: [id])
  
  messages              ConsultationMessage[]
  lastManualActive      DateTime?           // Human intervention timestamp for takeover cooldown
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model ConsultationMessage {
  id                    String              @id @default(uuid())
  consultationId        String
  consultation          ConsultationSession @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender                Role
  text                  String
  telegramMessageId     Int?
  createdAt             DateTime            @default(now())
}

model SpecializedProfile {
  id             String            @id @default(uuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  spineActive    Boolean           @default(false)
  maternalActive Boolean           @default(false)
  nutritionActive Boolean          @default(false)

  spineAssessments SpineAssessment[]
  maternalLogs     MaternalLog[]
  nutritionPlans   NutritionPlan[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model SpineAssessment {
  id             String            @id @default(uuid())
  profileId      String
  profile        SpecializedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  painLevel      Int               // 1-10
  hoursSeated    Int               
  postureScore   Float?
  assessmentDate DateTime          @default(now())
  notes          String?

  createdAt      DateTime          @default(now())
}

model MaternalLog {
  id             String            @id @default(uuid())
  profileId      String
  profile        SpecializedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  postpartumWeek Int
  painLevel      Int               // 1-10
  mood           String?           // e.g., "Good", "Anxious", "Depressed"
  pelvicRecovery String?           // e.g., "Improving", "Painful"
  logDate        DateTime          @default(now())

  createdAt      DateTime          @default(now())
}

model NutritionPlan {
  id             String            @id @default(uuid())
  profileId      String
  profile        SpecializedProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  dietaryGoals   String[]
  assignedMeals  String[]          // e.g., ["Teff Injera with Flaxseed", "Genfo"]
  restrictions   String[]
  isActive       Boolean           @default(true)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

